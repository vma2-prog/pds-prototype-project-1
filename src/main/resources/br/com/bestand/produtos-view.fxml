<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="produtos-container" stylesheets="@styles/produtos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.bestand.ProdutosController">
    <children>
        <!-- CABEÇALHO DA PÁGINA -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="page-title" text="Produtos" />
                        <Label styleClass="page-subtitle" text="Gerencie o catálogo, preços e níveis de estoque" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onNovoProduto" styleClass="btn-primary-compact" text="+ Novo Produto" />
            </children>
        </HBox>

        <!-- BARRA DE PESQUISA E ORDENAÇÃO -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="filter-bar">
            <children>
                <TextField fx:id="txtPesquisa" prefWidth="360.0" promptText="Pesquisar produto por nome ou código..." styleClass="filter-input" HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label styleClass="filter-label" text="Ordenar por:" />
                        <ComboBox fx:id="cmbOrdenacao" prefWidth="210.0" styleClass="filter-combo" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- TABELA DE PRODUTOS -->
        <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblProdutos" styleClass="data-table, produtos-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProduto" prefWidth="310.0" text="Produto" />
                        <TableColumn fx:id="colEstoque" prefWidth="120.0" text="Estoque" />
                        <TableColumn fx:id="colPrecoVenda" prefWidth="150.0" text="Preço de Venda" />
                        <TableColumn fx:id="colSituacao" prefWidth="170.0" text="Situação" />
                        <TableColumn fx:id="colAcoes" maxWidth="90.0" minWidth="80.0" prefWidth="85.0" resizable="false" sortable="false" text="Ações" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>