<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-scroll" stylesheets="@styles/vendas.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.bestand.VendasController">
    <content>
        <VBox spacing="18.0" styleClass="module-content">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="page-title" text="Vendas e devoluções" />
                        <Label styleClass="page-subtitle" text="Registre vendas, controle o estoque e processe devoluções." />
                        <Label styleClass="memory-notice" text="Os lançamentos ficam disponíveis somente enquanto o aplicativo estiver aberto." wrapText="true" />
                    </children>
                </VBox>

                <HBox spacing="14.0">
                    <children>
                        <VBox spacing="12.0" styleClass="card, operation-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Registrar uma venda" />
                                <Label styleClass="section-caption" text="Escolha o produto e a quantidade. O estoque será atualizado ao confirmar." wrapText="true" />
                                <ComboBox fx:id="cmbProduto" maxWidth="Infinity" promptText="Selecione um produto" styleClass="module-combo" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <TextField fx:id="txtQuantidadeVenda" prefWidth="110.0" promptText="Quantidade" styleClass="module-input" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnRegistrarVenda" onAction="#onRegistrarVenda" styleClass="btn-primary-compact" text="Registrar venda" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="12.0" styleClass="card, operation-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Registrar uma devolução" />
                                <Label styleClass="section-caption" text="Selecione uma venda. A quantidade devolvida volta ao estoque e reduz o saldo." wrapText="true" />
                                <ComboBox fx:id="cmbVendaDevolucao" maxWidth="Infinity" promptText="Selecione uma venda com itens disponíveis" styleClass="module-combo" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <TextField fx:id="txtQuantidadeDevolucao" prefWidth="110.0" promptText="Quantidade" styleClass="module-input" />
                                        <Label fx:id="lblQtdDisponivel" styleClass="section-caption" text="Disponível: —" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnRegistrarDevolucao" onAction="#onRegistrarDevolucao" styleClass="btn-secondary" text="Registrar devolução" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" styleClass="card">
                    <children>
                        <Label styleClass="section-title" text="Histórico de vendas" />
                        <Label styleClass="section-caption" text="O status indica se a venda está concluída, teve devolução parcial ou foi totalmente devolvida." wrapText="true" />
                        <TableView fx:id="tblVendas" prefHeight="300.0" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colDataVenda" prefWidth="145.0" text="Data e hora" />
                                <TableColumn fx:id="colIdVenda" prefWidth="100.0" text="Venda" />
                                <TableColumn fx:id="colProdutoVenda" prefWidth="230.0" text="Produto" />
                                <TableColumn fx:id="colQuantidadeVenda" prefWidth="90.0" text="Unidades" />
                                <TableColumn fx:id="colTotalVenda" prefWidth="125.0" text="Total" />
                                <TableColumn fx:id="colStatusVenda" prefWidth="145.0" text="Situação" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
