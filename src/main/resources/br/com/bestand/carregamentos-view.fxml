<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-scroll" stylesheets="@styles/carregamentos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.bestand.CarregamentosController">
    <content>
        <VBox spacing="18.0" styleClass="module-content">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="page-title" text="Carregamentos" />
                        <Label styleClass="page-subtitle" text="Registre mercadorias recebidas e acompanhe o custo de reposição." />
                        <Label styleClass="memory-notice" text="Cada carregamento aumenta o estoque. Os registros desta sessão são apagados ao fechar o aplicativo." wrapText="true" />
                    </children>
                </VBox>

                <VBox spacing="12.0" styleClass="card, operation-card">
                    <children>
                        <Label styleClass="section-title" text="Registrar entrada de mercadorias" />
                        <Label styleClass="section-caption" text="Informe o fornecedor, o produto, a quantidade recebida e o custo por unidade." wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtFornecedor" promptText="Nome do fornecedor" styleClass="module-input" HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="cmbProduto" prefWidth="240.0" promptText="Selecione um produto" styleClass="module-combo" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtQuantidade" prefWidth="130.0" promptText="Quantidade (un.)" styleClass="module-input" />
                                <TextField fx:id="txtCustoUnitario" prefWidth="170.0" promptText="Custo por unidade (R$)" styleClass="module-input" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onRegistrarCarregamento" styleClass="btn-primary-compact" text="Registrar carregamento" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" styleClass="card">
                    <children>
                        <Label styleClass="section-title" text="Histórico de carregamentos" />
                        <Label styleClass="section-caption" text="O custo total é calculado automaticamente: quantidade recebida × custo unitário." wrapText="true" />
                        <TableView fx:id="tblCarregamentos" prefHeight="330.0" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colData" prefWidth="145.0" text="Data e hora" />
                                <TableColumn fx:id="colId" prefWidth="100.0" text="Registro" />
                                <TableColumn fx:id="colFornecedor" prefWidth="150.0" text="Fornecedor" />
                                <TableColumn fx:id="colProduto" prefWidth="190.0" text="Produto" />
                                <TableColumn fx:id="colQuantidade" prefWidth="85.0" text="Unidades" />
                                <TableColumn fx:id="colCustoUnitario" prefWidth="125.0" text="Custo unitário" />
                                <TableColumn fx:id="colCustoTotal" prefWidth="125.0" text="Custo total" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
