<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane prefHeight="700.0" prefWidth="1100.0" styleClass="login-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.bestand.LoginController">
    <children>
        <!-- CARD CENTRAL DE LOGIN -->
        <VBox alignment="TOP_CENTER" fillWidth="true" maxHeight="-Infinity" spacing="18.0" styleClass="login-card">
            <children>
                <!-- CABEÇALHO DA MARCA -->
                <VBox alignment="CENTER" spacing="6.0">
                    <VBox.margin>
                        <Insets bottom="12.0" />
                    </VBox.margin>
                    <children>
                        <Label styleClass="login-brand-title" text="Bestand" />
                        <Label styleClass="login-brand-subtitle" text="Sistema de Gestão de Estoque" />
                    </children>
                </VBox>

                <!-- BANNER DE ERRO -->
                <Label fx:id="lblErroLogin" managed="false" maxWidth="Infinity" styleClass="error-banner" text="Usuário ou senha inválidos. Verifique os dados e tente novamente." visible="false" wrapText="true" />

                <!-- CAMPO: PERFIL DE USUÁRIO -->
                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="form-label" text="Perfil de usuário" />
                        <TextField fx:id="txtUsuario" onAction="#onEntrar" promptText="Ex: admin" styleClass="form-input" />
                    </children>
                </VBox>

                <!-- CAMPO: SENHA -->
                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="form-label" text="Senha" />
                        <PasswordField fx:id="txtSenha" onAction="#onEntrar" promptText="••••••••" styleClass="form-input" />
                    </children>
                </VBox>

                <!-- BOTÃO DE SUBMISSÃO -->
                <Button fx:id="btnEntrar" defaultButton="true" maxWidth="Infinity" onAction="#onEntrar" styleClass="btn-primary" text="Entrar no sistema">
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                </Button>

                <!-- RODAPÉ COM DICA -->
                <HBox alignment="CENTER" spacing="6.0" styleClass="login-footer">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                    <children>
                        <Label styleClass="login-hint-text" text="Acesso padrão do protótipo:" />
                        <Label styleClass="login-hint-badge" text="admin" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- BOTÃO DE TROCA DE TEMA (CANTO INFERIOR DIREITO) -->
        <Button fx:id="btnTema" onAction="#onAlternarTema" styleClass="theme-toggle-btn" StackPane.alignment="BOTTOM_RIGHT">
            <graphic>
                <SVGPath fx:id="svgIconeTema" content="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" styleClass="theme-icon" />
            </graphic>
            <tooltip>
                <Tooltip text="Alternar tema claro/escuro" />
            </tooltip>
        </Button>
    </children>
</StackPane>