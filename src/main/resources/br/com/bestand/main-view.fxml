<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.bestand.MainController">

    <!-- MENU LATERAL ESQUERDO -->
    <left>
        <VBox prefWidth="220.0" spacing="15.0" style="-fx-background-color: #f4f5f7; -fx-padding: 20; -fx-border-color: #e1e4e8; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Bestand" />
                
                <VBox spacing="10.0" style="-fx-padding: 20 0 0 0;">
                    <children>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #3498db; -fx-font-weight: bold;" text="Visão geral" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Produtos" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Categorias" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Estoque" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Movimentos" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Fornecedores" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Relatórios &amp; análises" />
                    </children>
                </VBox>
                
                <!-- Espaçador para empurrar as configurações para baixo -->
                <VBox VBox.vgrow="ALWAYS" />
                
                <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Configurações" />
            </children>
        </VBox>
    </left>

    <!-- CONTEÚDO CENTRAL E TOPO -->
    <center>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <!-- BARRA SUPERIOR -->
                <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e1e4e8; -fx-border-width: 0 0 1 0; -fx-padding: 0 30;">
                    <children>
                        <TextField fx:id="txtBuscar" onAction="#onBuscarProdutos" prefHeight="32.0" prefWidth="350.0" promptText="Buscar produtos..." style="-fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;" />
                        
                        <HBox HBox.hgrow="ALWAYS" />
                        
                        <!-- Perfil com ícone (círculo) e nome -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Circle radius="16.0" fill="#bdc3c7" />
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Admin" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- ÁREA DE CONTEÚDO PRINCIPAL -->
                <VBox spacing="25.0" style="-fx-padding: 25; -fx-background-color: #fafbfc;" VBox.vgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Visão geral" />

                        <!-- CARDS DE INDICADORES (MÉTRICAS) -->
                        <HBox spacing="15.0">
                            <children>
                                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e1e4e8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Produtos cadastrados" />
                                        <Label fx:id="lblTotalProdutos" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="0" />
                                    </children>
                                </VBox>
                                
                                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e1e4e8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Units. em estoque" />
                                        <Label fx:id="lblUnitsEstoque" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="0" />
                                    </children>
                                </VBox>
                                
                                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e1e4e8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Estoque baixo" />
                                        <Label fx:id="lblEstoqueBaixo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" text="0" />
                                    </children>
                                </VBox>
                                
                                <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e1e4e8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Sem estoque" />
                                        <Label fx:id="lblSemEstoque" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- SEÇÃO DE GRÁFICO (TENDÊNCIA) -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e1e4e8; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Tendência" />
                                
                                <BarChart fx:id="chartTendencia" legendVisible="false" VBox.vgrow="ALWAYS">
                                    <xAxis>
                                        <CategoryAxis side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis side="LEFT" />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>